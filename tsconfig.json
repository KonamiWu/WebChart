{
    "compilerOptions": {
        "target": "es6",        // 編譯到 ES6
        "module": "commonjs",   // 使用 CommonJS 模塊
        "outDir": "./tsout",     // 輸出目錄
        "rootDir": "./ts",     // 根目錄
        "strict": true,         // 啟用所有嚴格類型檢查選項
        "esModuleInterop": true // 允許默認導入
    },
    "include": ["./ts"],
    "exclude": ["node_modules"], // 排除 node_modules 目錄
    "watchOptions": {
    "watchFile": "useFsEvents"
    }
}
